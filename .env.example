# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amazon_finance
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MIN=2
DB_POOL_MAX=20

# Amazon SP-API (per-account credentials stored in DB, these are app-level)
SP_API_APP_CLIENT_ID=your_client_id
SP_API_APP_CLIENT_SECRET=your_client_secret

# Amazon Advertising API
ADS_API_CLIENT_ID=your_ads_client_id
ADS_API_CLIENT_SECRET=your_ads_client_secret

# Sync intervals (cron expressions)
SYNC_ORDERS_CRON=*/10 * * * *
SYNC_FINANCIAL_CRON=*/15 * * * *
SYNC_ADS_CRON=*/15 * * * *
AGGREGATION_CRON=*/20 * * * *
ALERTS_CRON=0 * * * *
RECONCILE_ORDERS_CRON=0 4 * * *

# Scheduler (set to 'false' to disable for manual testing)
SCHEDULER_ENABLED=true

# Scheduler (set to 'false' to disable for manual testing)
SCHEDULER_ENABLED=true


# Logging
LOG_LEVEL=info
